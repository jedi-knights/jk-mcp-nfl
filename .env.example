# Copy this file to .env and fill in real values for any settings you want to override.
# All variables here are optional — sensible defaults are used when unset.

# Transport mode for the MCP server: "stdio" (default) or "streamable-http"
MCP_TRANSPORT=stdio

# Bind address and port (only used when MCP_TRANSPORT=streamable-http)
HOST=0.0.0.0
PORT=8000

# ESPN public API base URL. Override only if proxying through another host.
API_HOST=https://site.api.espn.com

# On-disk cache directory for nflverse parquet files.
# Default if unset: ~/.cache/jk-mcp-nfl/nflverse
NFLVERSE_CACHE_DIR=

# The Odds API key (https://the-odds-api.com). The free tier permits 500
# requests/month. Without this, the get_current_odds tool returns
# "Unavailable" and every other tool still works.
ODDS_API_KEY=

# Logging level: DEBUG, INFO (default), WARNING, ERROR
LOG_LEVEL=INFO
